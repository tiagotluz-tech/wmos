{
  "name": "cgw",
  "version": "0.1.0",
  "private": true,
  "description": "Centro de Governança Wittel (CGW)",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "prettier": "3.6.2",
    "turbo": "2.10.7",
    "typescript": "5.9.2",
    "typescript-eslint": "8.46.2",
    "prisma": "7.9.1",
    "tsx": "4.20.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
